{
  "name": "ferracine-prod",
  "private": true,
  "version": "1.4.6",
  "description": "Folha de Produção Diária: registro de OSs do turno e PDF oficial, 100% offline no celular",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm test && pnpm build && pnpm test:e2e",
    "icons": "pwa-assets-generator --preset minimal-2023 public/icon.png",
    "logo": "node scripts/render-logo.mjs",
    "android:icons": "node scripts/android-icons.mjs",
    "apk": "vite build && node scripts/apk.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide": "^1.76.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vite-pwa/assets-generator": "^2.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
